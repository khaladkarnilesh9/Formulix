DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a securely generated secret in production. Development creates an ignored local secret.
DJANGO_SECRET_KEY=
# Leave empty for SQLite development. Set PostgreSQL credentials through the environment.
DATABASE_URL=
DB_SSLMODE=prefer
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
